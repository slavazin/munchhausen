# Copy to .env. Every knob in engine/munchhausen/config.py can also be set here (UPPER_CASE).

# --- Atlas -------------------------------------------------------------------------
# Driver connection string (mongodb+srv://user:pass@cluster/...). Required.
MONGODB_URI=
# Per-role users that enforce gold isolation (SPEC § 20.2). Each falls back to MONGODB_URI, which stays the
# admin user for the offline steps (`setup`, `build-world`). Verify with `munchhausen verify-roles`.
#   learner   : readWrite@munchhausen + custom role munch_world_views on `world`
#               (find, listCollections, createCollection, dropCollection — views only, no data writes)
#   evaluator : read@truth, read@world
#   executor  : read@world  (runs proposer pipelines and the nominator's world tool)
MONGODB_URI_LEARNER=
MONGODB_URI_EVALUATOR=
MONGODB_URI_EXECUTOR=

# --- Model and service keys --------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TYPESAFE_API_KEY=
RAINDROP_WRITE_KEY=
RAINDROP_QUERY_KEY=

# --- Run identity ------------------------------------------------------------------
RUN_ID=dev
